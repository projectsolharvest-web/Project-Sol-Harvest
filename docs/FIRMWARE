#include <iostream>
#include <chrono>
#include <thread>
#include <cmath>
#include <string>
#include <memory>

// AGHub Edge Firmware Core - Version 1.0.0
// Hardware Target: ARM64 Industrial Gateway (e.g., Raspberry Pi Compute Module 4 / Jetson Orin Nano)
// Protocol: CAN-Bus (BMS), Modbus RS-485 (Environment Sensors), GPIO Solenoid Lockout

namespace AGHub {

    // System Safety Thresholds
    constexpr float MAX_FLOW_VARIANCE_PERCENT = 2.0f; // >2% flow imbalance triggers anti-tamper lockout
    constexpr uint32_t SAFETY_TRIP_RESPONSE_MS = 500;  // 500ms maximum solenoid lockout time

    enum class LockoutReason {
        NONE,
        HYDRAULIC_LEAK_DETECTED,
        TAMPER_SWITCH_TRIPPED,
        BMS_CRITICAL_OVERHEAT,
        STARLINK_LINK_LOST
    };

    struct SensorTelemetry {
        float ambient_temp_c;
        float relative_humidity_pct;
        float supply_flow_lpm;
        float return_flow_lpm;
        float battery_soc_pct;
        float battery_temp_c;
        bool tamper_switch_closed;
    };

    class HardwareInterface {
    public:
        virtual ~HardwareInterface() = default;
        virtual SensorTelemetry sampleSensors() = 0;
        virtual void setSolenoidLockout(bool closed) = 0;
        virtual void transmitStarlinkTelemetry(const std::string& jsonPayload) = 0;
    };

    // Simulated Hardware Abstraction Layer (HAL)
    class SimulatedHAL : public HardwareInterface {
    private:
        bool solenoids_closed_ = false;

    public:
        SensorTelemetry sampleSensors() override {
            // Nominal operational telemetry with standard noise
            SensorTelemetry data;
            data.ambient_temp_c = 24.5f;
            data.relative_humidity_pct = 68.2f;
            data.supply_flow_lpm = 12.0f;
            data.return_flow_lpm = 11.95f; // Normal 0.41% variance
            data.battery_soc_pct = 92.4f;
            data.battery_temp_c = 31.0f;
            data.tamper_switch_closed = true; // True = Untampered
            return data;
        }

        void setSolenoidLockout(bool closed) override {
            solenoids_closed_ = closed;
            if (closed) {
                std::cout << "[EMERGENCY HARDWARE TRIP] Solenoid hydraulic valves set to NORMALLY CLOSED (NC). Flow isolated.\n";
            } else {
                std::cout << "[SYSTEM NORMAL] Hydraulic solenoids OPEN. Recirculation operational.\n";
            }
        }

        void transmitStarlinkTelemetry(const std::string& jsonPayload) override {
            std::cout << "[STARLINK SAT TELEMETRY TX] " << jsonPayload << "\n";
        }
    };

    class ControllerCore {
    private:
        std::unique_ptr<HardwareInterface> hal_;
        bool system_locked_out_ = false;

    public:
        explicit ControllerCore(std::unique_ptr<HardwareInterface> hal)
            : hal_(std::move(hal)) {}

        void evaluateHydraulicIntegrity(float supply_lpm, float return_lpm) {
            if (supply_lpm <= 0.0f) return;

            float delta = std::abs(supply_lpm - return_lpm);
            float variance = (delta / supply_lpm) * 100.0f;

            if (variance > MAX_FLOW_VARIANCE_PERCENT) {
                std::cerr << "[CRITICAL ALERT] Flow variance threshold exceeded: " 
                          << variance << "% (Max allowed: " << MAX_FLOW_VARIANCE_PERCENT << "%)\n";
                triggerLockout(LockoutReason::HYDRAULIC_LEAK_DETECTED);
            }
        }

        void triggerLockout(LockoutReason reason) {
            if (system_locked_out_) return; // Prevent redundant trips

            auto trip_start = std::chrono::high_resolution_clock::now();

            // Execute Immediate Mechanical Isolation
            hal_->setSolenoidLockout(true);
            system_locked_out_ = true;

            auto trip_end = std::chrono::high_resolution_clock::now();
            auto duration_ms = std::chrono::duration_cast<std::chrono::milliseconds>(trip_end - trip_start).count();

            std::cout << "[SAFETY MECHANISM] Lockout completed in " << duration_ms << " ms (Limit: " 
                      << SAFETY_TRIP_RESPONSE_MS << " ms).\n";

            // Dispatch High-Priority Alert via Starlink
            std::string alert_payload = "{\"event\":\"LOCKOUT_TRIPPED\",\"reason\":" + std::to_string(static_cast<int>(reason)) + "}";
            hal_->transmitStarlinkTelemetry(alert_payload);
        }

        void runTick() {
            SensorTelemetry telemetry = hal_->sampleSensors();

            // 1. Check Security Tamper Circuit
            if (!telemetry.tamper_switch_closed) {
                triggerLockout(LockoutReason::TAMPER_SWITCH_TRIPPED);
                return;
            }

            // 2. Evaluate Fluid Flow Differential Integrity
            evaluateHydraulicIntegrity(telemetry.supply_flow_lpm, telemetry.return_flow_lpm);

            // 3. Serialize and Dispatch Periodic Telemetry
            if (!system_locked_out_) {
                std::string payload = "{\"temp\":" + std::to_string(telemetry.ambient_temp_c) +
                                      ",\"humidity\":" + std::to_string(telemetry.relative_humidity_pct) +
                                      ",\"supply_lpm\":" + std::to_string(telemetry.supply_flow_lpm) +
                                      ",\"return_lpm\":" + std::to_string(telemetry.return_flow_lpm) +
                                      ",\"bms_soc\":" + std::to_string(telemetry.battery_soc_pct) + "}";
                hal_->transmitStarlinkTelemetry(payload);
            }
        }
    };
}

int main() {
    std::cout << "Starting Sol-Harvest AGHub Edge Controller Core (v1.0.0)...\n";
    
    auto hal = std::make_unique<AGHub::SimulatedHAL>();
    AGHub::ControllerCore controller(std::move(hal));

    // Execution Loop (1Hz Sampling Frequency)
    for (int i = 0; i < 5; ++i) {
        std::cout << "\n--- Sampling Tick " << (i + 1) << " ---\n";
        controller.runTick();
        std::this_thread::sleep_for(std::chrono::seconds(1));
    }

    return 0;
}
